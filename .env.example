# Gemini API Keys Account Pool
# Format: Name|Key (comma separated)
# Get your keys from: https://aistudio.google.com/apikey
#
# Example with multiple keys from different Google accounts:
GEMINI_KEYS="Primary|AIzaSyXXXXXXXXXXXXXXX,Secondary|AIzaSyYYYYYYYYYYYYYYY,Backup|AIzaSyZZZZZZZZZZZZZZZ"

# Legacy single-key mode (fallback if GEMINI_KEYS is not set):
# GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXX
