# Gemini API Keys Account Pool
# Format: Name|Key (comma separated)
# Get your keys from: https://aistudio.google.com/apikey
#
# Example with multiple keys from different Google accounts:
# 每个 Key 按 account_id 标识：<account_id>|<api_key>
# account_id 与账号元数据（name / email / project_id）见 app/core/accounts.py：
#   1 = qin    (gen-lang-client-0386075480)
#   2 = edis   (gen-lang-client-0059371429)
#   3 = sheron (gen-lang-client-0484613085)
# 分隔符支持换行或逗号；标识必须是数字，否则该条会被忽略并告警。
GEMINI_KEYS="1|AIzaSyXXXXXXXXXXXXXXX
2|AIzaSyYYYYYYYYYYYYYYY
3|AIzaSyZZZZZZZZZZZZZZZ"

# Legacy single-key mode (fallback if GEMINI_KEYS is not set):
# GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXX

# Models exposed through /v1/models (gemini-3.5-flash-lite has 500 RPD free tier quota)
GEMINI_DEFAULT_MODEL="gemini-3.5-flash-lite"
GEMINI_MODELS="gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.8-flash,gemini-3-flash-preview"

# ---------- 限速与账本（P1） ----------
# off | shadow | enforce。shadow = 照算令牌与账本，但不拦请求，用于观察一轮再切 enforce。
RATE_LIMIT_MODE=shadow
# 每次请求的总预算上限（httpx 兜底）。单请求预算由 X-Request-Timeout-Ms 决定。
# 超时三档，按模型组：floor 低于即拒 / default 没报时用 / ceiling 超过即截断
TIMEOUT_LITE_FLOOR_S=20
TIMEOUT_LITE_DEFAULT_S=40
TIMEOUT_LITE_CEIL_S=90
TIMEOUT_FLASH_FLOOR_S=45
TIMEOUT_FLASH_DEFAULT_S=90
TIMEOUT_FLASH_CEIL_S=180
TIMEOUT_TEXT_FLOOR_S=40
TIMEOUT_TEXT_DEFAULT_S=75
TIMEOUT_TEXT_CEIL_S=150
# 仅流式生效：首包超时
TTFB_STREAM_S=15
# 5xx / 超时的短冷却；连续 SLOT_FAIL_THRESHOLD 次转 SLOT_FAIL_COOLDOWN_S
TRANSIENT_COOLDOWN_S=3
SLOT_FAIL_THRESHOLD=2
SLOT_FAIL_COOLDOWN_S=300
# 单次逻辑请求最多尝试几个候选
RETRY_MAX_PER_REQUEST=3

# ---------- 冷却与重试 ----------
# Pool behavior. Retry-After from Google takes precedence over the default.
RATE_LIMIT_COOLDOWN_SECONDS=60
TRANSIENT_COOLDOWN_SECONDS=10
PERMISSION_COOLDOWN_SECONDS=300
MAX_RETRY_AFTER_SECONDS=86400
REQUEST_TIMEOUT_SECONDS=180
KEY_POOL_STATE_FILE="data/key_pool_state.json"

# Local-only by default. Set a strong token before binding to 0.0.0.0.
PROXY_HOST="127.0.0.1"
PROXY_PORT=8008
PROXY_RELOAD=false
# PROXY_API_TOKEN="replace-with-a-long-random-token"

# Comma-separated browser/app origins allowed to call the proxy.
PROXY_CORS_ORIGINS="http://127.0.0.1:8008,http://localhost:8008,tauri://localhost"

# ---- Google AI Studio 额度巡检（studio_inspector，level 2 用）----
# 账号名：决定独立的 Chrome 数据目录 data/studio_profiles/<账号>/
# 三个 Key 分属三个独立 Google 账号，Cookie 不通用，必须切换账号
STUDIO_ACCOUNT=
# 该账号对应的 Google AI Studio 项目 ID（查额度页要用）
STUDIO_AI_PROJECT_ID=
# 完整 URL，非空时优先于上面的 PROJECT_ID
STUDIO_AI_URL=
# Chrome 可执行文件；留空则按三处常见安装位置探测，都不在会直接报错
STUDIO_CHROME_PATH=
# Chrome 远程调试端口，9222 被占用时改这里
STUDIO_CDP_PORT=9222
